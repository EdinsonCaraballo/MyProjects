    %% Relaciones
    Company "1" --> "N" Sucursal : tiene
    Company "1" --> "N" Producto : posee
    Company "1" --> "N" Cliente : registra
    Company "1" --> "N" Pedido : recibe
    Company "1" --> "N" PrecioVenta : define
