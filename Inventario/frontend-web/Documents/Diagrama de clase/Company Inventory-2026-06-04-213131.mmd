    Company "1" --> "N" Perfil : asigna

    Sucursal "1" --> "N" LoteInventario : almacena
    Sucursal "1" --> "N" PrecioVenta : aplica
    Sucursal "1" --> "N" Pedido : atiende
    Sucursal "1" --> "1" DeliveryConfigSucursal : configura

    CatalogoProductos "1" --> "N" Producto : contiene
    CatalogoProductos "1" --> "1" Categoria : pertenece
    Categoria "1" --> "N" Categoria : subcategoria_de

    Producto "1" --> "N" LoteInventario : tiene_lotes
    Producto "1" --> "N" PrecioVenta : tiene_precios
    Producto "1" --> "N" PedidoDetalle : aparece_en
    Producto "1" --> "N" ClienteFavorito : es_favorito

    LoteInventario "1" --> "N" HistorialInventario : genera
    LoteInventario "1" --> "N" PedidoDetalle : se_descuenta

    TipoMovimiento "1" --> "N" HistorialInventario : define

    Moneda "1" --> "N" TasaCambio : origen
    Moneda "1" --> "N" TasaCambio : destino
    Moneda "1" --> "N" PrecioVenta : referencia
    Moneda "1" --> "N" LoteInventario : referencia
    Moneda "1" --> "N" PagoPedido : usada_en

    Cliente "1" --> "N" Pedido : realiza
    Cliente "1" --> "1" Usuario : autenticado_por

    UsuarioCliente "1" --> "N" ClienteFavorito : guarda
    UsuarioCliente "1" --> "N" Pedido : puede_realizar

    Pedido "1" --> "N" PedidoDetalle : contiene
    Pedido "1" --> "N" PagoPedido : tiene_pagos
    Pedido "1" --> "1" DespachoDelivery : genera

    Pais "1" --> "N" Region : tiene
    Region "1" --> "N" Estado : tiene
    Estado "1" --> "N" Ciudad : tiene
    Estado "1" --> "N" Municipio : tiene
    Municipio "1" --> "N" Parroquia : tiene
    Parroquia "1" --> "N" Sector : tiene

    DireccionSucursal "1" --> "1" Pais : pertenece
    DireccionSucursal "1" --> "1" Region : pertenece
    DireccionSucursal "1" --> "1" Estado : pertenece
    DireccionSucursal "1" --> "1" Ciudad : pertenece
    DireccionSucursal "1" --> "1" Municipio : pertenece
    DireccionSucursal "1" --> "1" Parroquia : pertenece
    DireccionSucursal "1" --> "1" Sector : pertenece

    Sucursal "1" --> "1" DireccionSucursal : ubicada_en

    MetodoPago "1" --> "N" PagoPedido : usado_en

    Perfil "1" --> "N" Usuario : asigna